#!/bin/bash

# Turn Bitwarden secrets on or off for this desktop session.
#
#   secrets on       unlock Bitwarden (Omarchy's password card) and share secrets
#   secrets off      lock Bitwarden and drop secrets from shells
#   secrets toggle   switch between the two
#   secrets status   print on/off (exit 0 when on); --json for the bar widget
#
# The bar's (x) indicator (plugin chickymonkeys.secrets) runs this same command.
# Shells read the toggle at every prompt (shell/secrets.bash), so open
# terminals pick secrets up, or drop them, at their next prompt. The toggle
# lives in $XDG_RUNTIME_DIR, so every login starts with it off.

set -uo pipefail

PLUGIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
flag="${XDG_RUNTIME_DIR:-/run/user/$UID}/secrets-enabled"
glyph="󰫧"

notify() {
  command -v omarchy-notification-send &>/dev/null || return 0
  omarchy-notification-send --app-name Secrets -g "$glyph" "$@" &>/dev/null
}

# rbw and fnox may start long-lived agents; they must not inherit the change
# lock (fd 9), or it stays held after this command exits.
run() { "$@" 9>&-; }

enabled() { [[ -e $flag ]]; }
unlocked() { run rbw unlocked &>/dev/null; }

shell_ready() {
  grep -qs 'chickymonkeys.secrets/shell/secrets.bash' ~/.bashrc
}

missing_setup() {
  local missing=()
  command -v rbw &>/dev/null || missing+=(rbw)
  command -v fnox &>/dev/null || missing+=(fnox)
  shell_ready || missing+=("shell integration")
  ((${#missing[@]})) && printf '%s\n' "${missing[@]}"
}

turn_on() {
  enabled && unlocked && return 0

  local missing
  if missing=$(missing_setup); then
    notify -u critical "Secrets need setup" "Missing: ${missing//$'\n'/, }. Run $PLUGIN_DIR/install.sh"
    echo "Missing: ${missing//$'\n'/, }. Run $PLUGIN_DIR/install.sh" >&2
    return 1
  fi

  local error
  if ! error=$(run rbw unlock 2>&1); then
    # Cancelling the password prompt is a decision, not an error: stay quiet.
    if [[ $error != *cancelled* ]]; then
      notify -u critical "Secrets could not unlock" "${error##*: }"
      echo "$error" >&2
    fi
    return 1
  fi

  # Fill fnox's in-memory cache now, so terminals load secrets instantly.
  run fnox exec -- true &>/dev/null
  touch "$flag"
  # The indicator in the bar is the confirmation; no toast for what you just did.
  echo "Secrets on: terminals load them at their next prompt"
}

turn_off() {
  local reason=${1:-}

  rm -f "$flag"
  run rbw lock &>/dev/null
  run fnox daemon stop &>/dev/null

  if [[ $reason == expired ]]; then
    notify "Secrets off" "Bitwarden locked itself after its timeout"
  else
    echo "Secrets off: terminals drop them at their next prompt; running programs keep theirs"
  fi
}

print_status() {
  local on=false open=false ready=true
  enabled && on=true
  unlocked && open=true
  missing_setup &>/dev/null && ready=false

  if [[ ${1:-} == --json ]]; then
    printf '{"enabled":%s,"unlocked":%s,"ready":%s}\n' "$on" "$open" "$ready"
  else
    [[ $on == true ]] && echo on || echo off
  fi
  [[ $on == true ]]
}

# One change at a time: a double click must not open two password prompts.
lock_changes() {
  exec 9>"$flag.lock"
  if ! flock -n 9; then
    echo "secrets: another on/off is still running" >&2
    exit 0
  fi
}

case "${1:-status}" in
  on) lock_changes; turn_on ;;
  off) lock_changes; [[ ${2:-} == --expired ]] && turn_off expired || turn_off ;;
  toggle) lock_changes; if enabled; then turn_off; else turn_on; fi ;;
  status) print_status "${2:-}" ;;
  -h | --help | help) sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Usage: secrets [on|off|toggle|status [--json]]" >&2; exit 2 ;;
esac
